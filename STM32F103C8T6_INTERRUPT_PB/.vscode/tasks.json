{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$gcc"
            }
        },
        {
            "label": "Stop ST-Link GDB Server",
            "type": "shell",
            "command": "taskkill",
            "args": [
                "/IM",
                "ST-LINK_gdbserver.exe",
                "/F"
            ],
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
